{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rise.local/schemas/qwen-abbreviation-attempt.schema.json",
  "title": "Qwen3 abbreviation study API attempt",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "run_id",
    "experiment_id",
    "model_key",
    "strategy_id",
    "prompt_id",
    "prompt_sha256",
    "attempt_number",
    "success",
    "status",
    "generation_id",
    "request_id",
    "actual_model_id",
    "actual_provider_id",
    "finish_reason",
    "native_finish_reason",
    "truncated",
    "latency_ms",
    "time_to_first_token_ms",
    "error",
    "started_at_utc",
    "completed_at_utc"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "run_id": {
      "type": "string",
      "minLength": 1
    },
    "experiment_id": {
      "type": "string",
      "minLength": 1
    },
    "model_key": {
      "type": "string",
      "minLength": 1
    },
    "strategy_id": {
      "type": "string",
      "minLength": 1
    },
    "prompt_id": {
      "type": "string",
      "minLength": 1
    },
    "prompt_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "attempt_number": {
      "type": "integer",
      "minimum": 1
    },
    "success": {
      "type": "boolean"
    },
    "status": {
      "enum": [
        "success",
        "failure"
      ]
    },
    "generation_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "request_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "actual_model_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "actual_provider_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "finish_reason": {
      "type": [
        "string",
        "null"
      ]
    },
    "native_finish_reason": {
      "type": [
        "string",
        "null"
      ]
    },
    "truncated": {
      "type": [
        "boolean",
        "null"
      ]
    },
    "latency_ms": {
      "type": "number",
      "minimum": 0
    },
    "time_to_first_token_ms": {
      "type": [
        "number",
        "null"
      ],
      "minimum": 0
    },
    "error": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "$ref": "#/$defs/error"
        }
      ]
    },
    "started_at_utc": {
      "type": "string",
      "format": "date-time"
    },
    "completed_at_utc": {
      "type": "string",
      "format": "date-time"
    }
  },
  "$defs": {
    "error": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "message",
        "http_status",
        "retryable"
      ],
      "properties": {
        "type": {
          "type": "string",
          "minLength": 1
        },
        "message": {
          "type": "string",
          "minLength": 1
        },
        "http_status": {
          "type": [
            "integer",
            "null"
          ]
        },
        "retryable": {
          "type": "boolean"
        }
      }
    }
  }
}

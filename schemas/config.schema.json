{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rise.local/schemas/qwen-abbreviation-config.schema.json",
  "title": "Qwen3 abbreviation study configuration",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "experiment_id",
    "dataset",
    "output_dir",
    "randomization_seed",
    "generation",
    "retry",
    "strategies",
    "models"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "experiment_id": {
      "type": "string",
      "minLength": 1
    },
    "dataset": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "format": {
          "enum": [
            "jsonl",
            "csv"
          ]
        },
        "expected_prompt_rows": {
          "type": "integer",
          "minimum": 1
        },
        "expected_set_count": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "output_dir": {
      "type": "string",
      "minLength": 1
    },
    "randomization_seed": {
      "type": "string",
      "minLength": 1
    },
    "generation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "temperature",
        "top_p",
        "max_output_tokens",
        "thinking_enabled",
        "reasoning_max_tokens",
        "request_timeout_seconds"
      ],
      "properties": {
        "temperature": {
          "type": "number",
          "minimum": 0
        },
        "top_p": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 1
        },
        "max_output_tokens": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1
        },
        "thinking_enabled": {
          "type": "boolean"
        },
        "reasoning_max_tokens": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1
        },
        "request_timeout_seconds": {
          "type": "number",
          "exclusiveMinimum": 0
        }
      }
    },
    "retry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "max_attempts",
        "initial_backoff_seconds",
        "maximum_backoff_seconds"
      ],
      "properties": {
        "max_attempts": {
          "type": "integer",
          "minimum": 1
        },
        "initial_backoff_seconds": {
          "type": "number",
          "minimum": 0
        },
        "maximum_backoff_seconds": {
          "type": "number",
          "minimum": 0
        }
      }
    },
    "strategies": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "prompt_prefix": {
            "type": "string",
            "default": ""
          },
          "prompt_suffix": {
            "type": "string",
            "default": ""
          }
        }
      }
    },
    "models": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "key",
          "gateway",
          "model_id",
          "credential_env"
        ],
        "properties": {
          "key": {
            "type": "string",
            "minLength": 1
          },
          "gateway": {
            "enum": [
              "huggingface",
              "openrouter"
            ]
          },
          "model_id": {
            "type": "string",
            "minLength": 1
          },
          "credential_env": {
            "type": "string",
            "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
          },
          "requested_provider": {
            "type": [
              "string",
              "null"
            ]
          },
          "prompt_prefix": {
            "type": "string",
            "default": ""
          },
          "prompt_suffix": {
            "type": "string",
            "default": ""
          }
        }
      }
    }
  }
}
